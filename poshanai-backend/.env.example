PORT=5000
TRUST_PROXY_HOPS=0
# Use development for local work; production deployments must set NODE_ENV=production.
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/poshanai
MONGODB_TLS=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GEMINI_API_KEY=your_gemini_api_key_here
OMNIROUTE_URL=http://localhost:20128/v1/chat/completions
OMNIROUTE_MODEL=gemini-2.0-flash
OMNIROUTE_API_KEY=
CLIENT_URL=http://localhost:5173
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_char_app_password
RESEND_API_KEY=re_your_api_key
RESEND_FROM=PoshanAI <no-reply@your-verified-domain.com>
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
